# Stage 1: Build stage
FROM --platform=$BUILDPLATFORM golang:1.26-alpine@sha256:ecb67f987aa1a57794c91d19ade7ae0209f2f0f5496aaef9e6ae85ddf92d02ab AS builder

ARG TARGETOS
ARG TARGETARCH

WORKDIR /app

# Install necessary build tools
RUN apk add --no-cache git make

# Copy go.mod and go.sum first to leverage Docker caching
COPY go.mod go.sum ./
RUN go mod download

# Copy the rest of the application code
COPY . .

# Build the server application. GIT_REVISION (the same build argument as the
# revision label below) is stamped into the binary too: the build context is a
# `git archive` with no .git, so the Go toolchain's own VCS stamp is empty, and
# the heartbeat and the schema-version ledger would otherwise record no
# revision for a deployed build.
#
# PLATFORM_VERSION is the platform release the image is built for (the
# release workflow passes the version of the tag); empty for a build from
# source, which then reports no version rather than an invented one.
ARG GIT_REVISION=unknown
ARG PLATFORM_VERSION=
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -a -installsuffix cgo -ldflags="-w -s -X main.stampedRevision=${GIT_REVISION} -X main.stampedVersion=${PLATFORM_VERSION}" -o server ./cmd/server

# Stage 2: Runtime image
#
# Pinned by digest, so a rebuild cannot move the base silently; keep it on a
# supported Alpine release, or every rebuild is a fresh image on a base that
# receives no security updates. Moving it is safe by construction here: the
# binary is built CGO_ENABLED=0, so it is static and does not link musl at
# all, and the four packages below exist in every Alpine.
FROM alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf

WORKDIR /app

# Add CA certificates for HTTPS and zstd/xz for server-side OS image compression
RUN apk --no-cache add ca-certificates tzdata zstd xz

# Set timezone
ENV TZ=UTC

# Create a non-root user and group.
#
# The uid/gid are PINNED, and that is what makes a base-image bump survivable
# rather than an outage. `adduser -S` picks the next free system id, which is an
# implementation detail of the base image: the storage directory on the host is
# owned by 100:101, so a base image that handed out a different id would leave
# the backend unable to read a single OS image — at runtime, long after the
# build and the deploy both reported success.
RUN addgroup -S -g 101 appgroup && adduser -S -u 100 -G appgroup appuser

# Copy the binary from the builder stage
COPY --from=builder /app/server /app/server
# The third-party notices the compiled dependencies require to travel with a
# binary distribution; generated by tools/notices in the repository.
COPY --from=builder /app/THIRD-PARTY-NOTICES.md /app/THIRD-PARTY-NOTICES.md

# Use non-root user
USER appuser

# Expose the application port
EXPOSE 8080

# Set environment variable
ENV APP_ENV=production

# Build provenance. GIT_REVISION is the commit the source came from and is
# supplied by the build (`--build-arg GIT_REVISION=$(git rev-parse HEAD)`); it
# defaults to "unknown" so a build without it still succeeds and says so.
#
# This exists because a deploy record kept in prose is enforced by nothing:
# without the label, the only way to answer "which commit is running" after a
# deploy is to compare binaries. A label
# on the image itself travels with the thing it describes, so
# `docker inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}'`
# answers it on the host, with no log to keep in step.
ARG GIT_REVISION=unknown
ARG PLATFORM_VERSION=
LABEL org.opencontainers.image.revision=$GIT_REVISION
LABEL org.opencontainers.image.version=$PLATFORM_VERSION
LABEL org.opencontainers.image.source=https://github.com/uptime-lab/orchestrator

# Command to run the application
CMD ["/app/server"]

