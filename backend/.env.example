# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=orchestrator_platform
DB_SSLMODE=disable

# JWT Configuration. A placeholder, or any value under 32 characters, is refused
# at boot in EVERY mode; generate a real one with `openssl rand -hex 32`, or let
# `server --init-secrets DIR` write every secret file and use the _FILE forms.
JWT_SECRET_KEY=change-me
JWT_ACCESS_TOKEN_TTL=24h
JWT_REFRESH_TOKEN_TTL=168h
JWT_ISSUER=orchestrator

# Secrets at rest and the signed-download key (same rule as the JWT key).
SECRETS_ENCRYPTION_KEY=change-me
CDN_SIGNING_KEY=change-me

# Application Environment.
#
# Leave APP_ENV unset for a real install: unset, or any value other than
# development|dev|local|test, means PRODUCTION, and production refuses to boot on
# the placeholders above and on other insecure defaults. Development mode turns
# the OTHER refusals (plaintext agent channel, open sign-up, CORS) into warnings
# and must be opted into explicitly, only on a machine that is not reachable from
# the internet:
#APP_ENV=development
#
# The three placeholder secrets above are refused even in development, because a
# key printed in this repository signs forgeable tokens wherever it runs. This
# opt-in disables that one refusal, in development modes only (production
# ignores it): with it, this file boots a local server whose every token and
# every stored secret is readable by anyone with the source. Replace the
# placeholders instead as soon as the server is reachable by anyone but you.
ALLOW_INSECURE_DEV_SECRETS=true
