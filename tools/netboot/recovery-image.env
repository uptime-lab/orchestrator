# The prebuilt recovery image this platform release was tested with.
#
# The image carries no server address and no credential: a device learns its
# server from its bootloader or from the adoption file on a provisioning
# card. What is per install is the SIGNATURE — tools/netboot/sign-boot-image.sh
# signs the image with the install's own key — so one published image serves
# every install. It is built from the orchestrator-boot-image repository,
# whose README is the procedure for building it yourself; the release named
# here also carries the corresponding source the image's licences require.
#
# The installer (tools/install/install.sh) downloads RECOVERY_IMAGE_URL and
# refuses a file whose SHA-256 is not the one below. RECOVERY_IMAGE_AGENT is
# the agent version baked into the image.
RECOVERY_IMAGE_URL=https://github.com/uptime-lab/orchestrator-boot-image/releases/download/base-1cd5ae3e-agent-0.8.8/boot.img
RECOVERY_IMAGE_SHA256=37d9c9af7f56035f75f2c187f7891ae1506ad3800cf11025430ac0603cdf2772
RECOVERY_IMAGE_AGENT=0.8.8
