config_local/*
!config_local/.gitkeep

# Env files and Docker secrets. The pattern is ".env*", not a bare ".env": a bare
# name matches only that one file and leaves .env.<name> and every dated
# .env.<name>.bak.* visible, and "*.bak" below does not match a dated suffix
# either. A deploy checkout keeps its secret files under ./secrets, so one
# "git add -A" there must find nothing to stage.
.env*
!.env*.example
secrets/
# The owner's generated first password, written by tools/install/install.sh.
/owner-password

# Local-only notes — never commit
*.local.md

