# Cloud service-account key files, as the provider console names them
# (<project>-<6 digits>-<12 hex>.json)
*-[0-9][0-9][0-9][0-9][0-9][0-9]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].json

# Local builds (`go build` in the module directory) and local runtime state.
backend/server
agent/agent
agent/adoption-file.txt
backend/storage/*
tools/agent-signer/agent-signer
tools/entitlement-signer/entitlement-signer

# OS images used for local provisioning tests (never committed)
*.img

# Product documentation drops (large binaries, never committed)
*.pdf

# Python bytecode, generated by running the tools' *_test.py; never source
__pycache__/
*.pyc

# The GPL corresponding-source archives an install serves at /source/ — placed
# by hand next to the compose file; release artefacts of hundreds of
# megabytes, never source.
source-offer/
