{
  "printWidth": 80,
  "tabWidth": 2,
  "singleQuote": true,
  "semi": false,
  "trailingComma": "all",
  "plugins": [
    "prettier-plugin-tailwindcss",
    "@ianvs/prettier-plugin-sort-imports"
  ],
  "importOrder": [
    "^@root/(.*)$", "",
    "^@/routes/(.*)$", "",
    "^@/pages/(.*)$", "",
    "^@/widgets/(.*)$", "",
    "^@/entities/(.*)$", "",
    "^@/shared/(.*)$", "",
    "^[./]"
  ],
  "importOrderParserPlugins": ["typescript", "jsx", "decorators-legacy"],
  "importOrderTypeScriptVersion": "5.5.4"
}
