{
  "name": "orchestrator-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --check src",
    "preview": "vite preview",
    "prepare": "husky",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "pnpm run lint --fix",
      "pnpm run format --write"
    ]
  },
  "dependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@headlessui/react": "2.2.10",
    "@tanstack/react-query": "5.108.2",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/router-devtools": "1.167.4",
    "@uiw/react-codemirror": "^4.25.12",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "^13.0.2",
    "axios": "1.21.1",
    "clsx": "2.1.1",
    "create-locator": "0.0.27",
    "effector": "23.4.4",
    "effector-react": "23.3.0",
    "i18next": "27.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-i18next": "18.0.3",
    "tailwind-clip-path": "1.0.0",
    "yup": "1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tanstack/router-plugin": "1.169.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "autoprefixer": "10.7.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react": "7.37.5",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "overrides": {
      "minimatch@3": "^3.1.4",
      "minimatch@9": "^9.0.7",
      "brace-expansion@1": "^1.1.16",
      "brace-expansion@2": "^2.1.2",
      "js-yaml@4": "^4.3.0",
      "flatted": "^3.4.2",
      "glob@10": "^10.5.0",
      "ajv@6": "^6.14.0",
      "esbuild": "^0.25.0",
      "rollup": "^4.59.0",
      "picomatch@2": "^2.3.2",
      "picomatch@4": "^4.0.4",
      "@babel/core": "^7.29.6",
      "@babel/helpers": "^7.26.10",
      "diff@8": "^8.0.3",
      "yaml@2": "^2.8.3",
      "browserslist": "^4.28.7",
      "@humanfs/node": "^0.16.8",
      "postcss-selector-parser@6": "^6.1.3"
    }
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  }
}
