# =============================================================================
# Orchestrator Local Development Environment Variables
# =============================================================================
# Copy this file to .env.local in the project root (optional - defaults are provided)

# Local development uses sensible defaults, but you can override here if needed

# -----------------------------------------------------------------------------
# HOST IP - For Local Network Deployment
# -----------------------------------------------------------------------------
# Set this to your machine's local IP address for network access
# Example: HOST_IP=192.0.2.10
# If not set, defaults to "localhost"
HOST_IP=

# Database (defaults to postgres/postgres)
# DB_NAME=orchestrator
# DB_USER=postgres
# DB_PASSWORD=postgres

# JWT Secret. The loader reads JWT_SECRET_KEY (a JWT_SECRET line is inert), and
# refuses a placeholder or a value under 32 characters in EVERY mode.
# JWT_SECRET_KEY=

# A development mode (APP_ENV=development) may boot on placeholder or empty
# secrets ONLY with this opt-in; it disables the refusal of a weak
# JWT_SECRET_KEY, SECRETS_ENCRYPTION_KEY and CDN_SIGNING_KEY, nothing else, and
# production ignores it. Every token such a server signs is forgeable by anyone
# with the source — keep it off wherever anyone but you can reach the server.
# ALLOW_INSECURE_DEV_SECRETS=true

# -----------------------------------------------------------------------------
# OPTIONAL: SD/USB provisioning bundle
# -----------------------------------------------------------------------------
# Directory with the extracted boot-partition files that POST /api/v1/provisioning/sd
# zips together with a generated node-adoption.txt. If unset, the endpoint is disabled.
# PROVISIONING_SD_PAYLOAD_DIR=/app/net_install/sd-payload
# Directory with the signed bootstrap boot.img/boot.sig served by the network-first
# HTTP-boot endpoint (GET /http-boot/:serial/:file). If unset, the endpoint is disabled.
# PROVISIONING_HTTP_BOOT_DIR=/app/net_install

# -----------------------------------------------------------------------------
# OPTIONAL: Secret encryption
# -----------------------------------------------------------------------------
# Key used to AES-256-GCM encrypt stored secret values at rest. Any length is
# accepted (hashed to 32 bytes). Empty refuses the boot in every mode unless
# ALLOW_INSECURE_DEV_SECRETS=true in a development mode, which runs on an
# INSECURE fixed development key. At least 32 characters: `openssl rand -hex 32`.
# SECRETS_ENCRYPTION_KEY=change-me-to-a-strong-random-value

# -----------------------------------------------------------------------------
# OPTIONAL: Docker Image Versions
# -----------------------------------------------------------------------------
# The community compose takes the platform release to install, for example
# PLATFORM_VERSION=<version> (docs/INSTALL.md).

